<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#00ffff22" />
    <stroke
        android:width="2dp"
        android:color="#00ffff" />
</shape>

